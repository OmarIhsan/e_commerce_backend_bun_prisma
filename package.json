{
  "name": "e_commerce_backend_bun_prisma",
  "version": "1.0.0",
  "description": "High-performance E-Commerce Backend powered by Bun.js, Elysia.js, and Prisma ORM",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "prisma generate",
    "vercel-build": "prisma generate",
    "test": "bun test",
    "db:bootstrap": "bun src/db/bootstrap.ts",
    "db:seed": "bun prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@prisma/client": "^6.4.1",
    "elysia": "^1.2.22"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}