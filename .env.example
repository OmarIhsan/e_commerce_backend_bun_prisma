# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public&connection_limit=10&pool_timeout=10"

# JWT Configuration
JWT_SECRET="replace_with_a_secure_256_bit_secret_key_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
