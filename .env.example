# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL / Local PostgreSQL)
# DATABASE_URL: Neon connection pooler URL (pgbouncer=true, for runtime transactions and queries)
# Format: postgresql://USER:PASSWORD@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public&connection_limit=10&pool_timeout=10"

# DIRECT_URL: Direct unpooled connection to Neon PostgreSQL (port 5432, for Prisma migrations and DDL)
# Format: postgresql://USER:PASSWORD@ep-xyz.region.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# Database Self-Provisioning Engine
# Set to 'true' to auto-deploy migrations and seed baseline catalog on startup
AUTO_BOOTSTRAP_DB=true

# JWT Configuration
JWT_SECRET="replace_with_a_secure_256_bit_secret_key_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
